# Copy to ".env" next to docker-compose.yml (Docker Compose loads it automatically).

# --- Windows / Docker Desktop: use Ollama installed on the host (your `ollama list`) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_OLLAMA_MODEL=qwen2.5:0.5b
# Do NOT set COMPOSE_PROFILES — the bundled ollama service stays off (~2GB pull saved).

# --- Air-gapped or Linux bundle: use the ollama container (comment host lines above, then:) ---
# OLLAMA_BASE_URL=http://ollama:11434
# DEFAULT_OLLAMA_MODEL=qwen2.5:0.5b
# COMPOSE_PROFILES=bundle
